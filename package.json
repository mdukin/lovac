{
  "name": "react-nodejs-postgresql-app",
  "version": "1.0.0",
  "description": "A simple todo app with React frontend, Node.js backend, and PostgreSQL database",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm start",
    "server": "nodemon server.js",
    "build": "cd client && npm run build",
    "install-client": "cd client && npm install",
    "setup-db": "node setup-db.js",
    "test-api": "node test-api.js",
    "heroku-postbuild": "npm run install-client && npm run build"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": ["react", "nodejs", "postgresql", "todo", "fullstack"],
  "author": "Your Name",
  "license": "MIT"
}